# ---------------------------------------------------------------------------
# B.I.R.D.S — files that must never reach the repository
# ---------------------------------------------------------------------------

# --- Real sample data -------------------------------------------------------
# Only the EMPTY data-entry templates are tracked; they are part of the
# product.  Anything dropped into templates/ that carries real analyses
# stays local — a working dataset is the author's to publish, and some of
# it belongs to collaborators.  Add a pattern here rather than relying on
# remembering not to `git add` it.
templates/*_data_*.xlsx
!templates/BIRDS_data_template.xlsx
!templates/BIRDS_data_template.csv
*.birds
*.birdstyle

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual environments ---------------------------------------------------
.venv/
venv/
ENV/
env/
.python-version

# --- Packaging (PyInstaller) ------------------------------------------------
*.manifest
*.spec
# …except the one recipe the app is built from.
!packaging/birds.spec

# --- Testing / coverage -----------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# --- Editors and IDEs -------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.spyproject/
.ropeproject/

# --- OS ---------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- R (this tree was previously used from RStudio) -------------------------
.Rhistory
.Rapp.history
.RData
.Ruserdata

# --- Runtime artefacts ------------------------------------------------------
# Crash log and autosaves live in ~/.birds/, but keep these just in case.
crash.log
*.log
